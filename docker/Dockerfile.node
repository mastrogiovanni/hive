# Node image: runs one pipeline part (model slice). Run with --gpus all for GPU.
FROM pytorch/pytorch:2.5.0-cuda12.1-cudnn9-runtime

WORKDIR /app

# Install uv for fast, cached installs
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Dependencies from project (transformers, etc.)
COPY pyproject.toml uv.lock /app/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project

# App: src (common, split_two_machines) + node entrypoint (build context = project root)
COPY src/ /app/src/
COPY node.py /app/node.py

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["/usr/local/bin/uv"]
