# Controller image: TCP listener for nodes and clients.
FROM python:3.12-slim

WORKDIR /app

# Install uv and minimal deps (controller has no torch in hot path)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --no-cache 'torch>=2.0' numpy

COPY src/ /app/src/
COPY control.py /app/control.py

ENV PYTHONPATH=/app/src

EXPOSE 9000

CMD ["uv", "run", "/app/control.py"]
